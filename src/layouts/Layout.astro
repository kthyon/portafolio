---
import {siteData} from '../data/site';
import {palette,rgbChannels} from '../data/palette.mjs';
interface Props {lang?: 'en'|'es';page?: 'home'|'about'|'nexo'|'lab'}
const {lang='en',page='home'}=Astro.props;
const config=siteData[lang];
const origin='https://kthyon.github.io';
const base='/portafolio/';
const root=origin+base;
const route=page==='home'?'':page==='nexo'?'work/nexo/':page+'/';
const url=root+(lang==='es'?'es/':'')+route;
const enUrl=root+route, esUrl=root+'es/'+route;
const metadata={
 en:{home:{title:'Cris Alvarado | Software Engineer, AI Systems & MCP',description:'Software Engineer at Mercado Libre building AI agents, MCP tools and distributed software for Mercado Pago. Creator of Nexo and ML/Deep Learning instructor.'},about:{title:'About Cristian Alvarado | Software Engineer at Mercado Libre',description:'Explore Cristian Alvarado’s experience in Mercado Pago software, AI agents, MCP, backend engineering and Machine Learning teaching at UTP.'},nexo:{title:'Nexo Case Study | ML Teaching Tool by Cristian Alvarado',description:'How Cristian Alvarado created Nexo for ML and Deep Learning classes: the problem, architecture, JavaScript, Three.js, Python, D1/SQLite and demo screenshots.'},lab:{title:'Skills Invaders | Creative Coding by Cristian Alvarado',description:'A browser game exploring canvas interactions and animation. A creative coding experiment by Cristian Alvarado, separate from his engineering portfolio.'}},
 es:{home:{title:'Cris Alvarado | Ingeniero de Software, IA y MCP',description:'Software Engineer en Mercado Libre: agentes de IA, herramientas MCP y software distribuido para Mercado Pago. Creador de Nexo y docente de ML y Deep Learning.'},about:{title:'Cristian Alvarado | Trayectoria en Software e IA',description:'Conoce la experiencia de Cristian Alvarado en Mercado Pago, agentes de IA, MCP, desarrollo backend y docencia de Machine Learning en la UTP.'},nexo:{title:'Nexo | Herramienta Docente Creada por Cristian Alvarado',description:'Cómo Cristian Alvarado creó Nexo para sus clases de ML y Deep Learning: problema, arquitectura, JavaScript, Three.js, Python, D1/SQLite y capturas de demostración.'},lab:{title:'Skills Invaders | Programación Creativa de Cristian Alvarado',description:'Un juego de navegador para explorar interacciones y animación con canvas. Experimento creativo de Cristian Alvarado, separado de su portafolio profesional.'}}
};
const {title,description}=metadata[lang][page];
const image=root+(page==='nexo'?'projects/nexo-overview.png':'social-card.png');
const imageWidth=page==='nexo'?'1440':'1200',imageHeight=page==='nexo'?'1000':'630';
const personId=root+'#person', websiteId=root+'#website', nexoId=root+'work/nexo/#application';
const person={'@type':'Person','@id':personId,name:'Cristian Alvarado',alternateName:'Cris Alvarado',jobTitle:'Software Engineer',url:root,image:root+'portrait-cris-grain.webp',worksFor:{'@type':'Organization',name:'Mercado Libre'},alumniOf:{'@type':'EducationalOrganization',name:config.about.education.institution},hasCredential:{'@type':'EducationalOccupationalCredential',name:config.about.education.name,credentialCategory:'Degree',recognizedBy:{'@type':'EducationalOrganization',name:config.about.education.institution}},sameAs:['https://www.linkedin.com/in/crisalvarado-ingeniero/','https://github.com/kthyon'],knowsAbout:['AI agents','Model Context Protocol','Developer tooling','Enterprise integrations','Backend engineering','Go','TypeScript','React','Machine Learning','Deep Learning'],knowsLanguage:[{'@type':'Language',name:'Spanish',alternateName:'es'},{'@type':'Language',name:'English',alternateName:'en'}]};
const website={'@type':'WebSite','@id':websiteId,name:'Cristian Alvarado - Engineering Portfolio',alternateName:'Cris Alvarado',url:root,inLanguage:['en','es'],publisher:{'@id':personId}};
const webPage={'@type':page==='home'||page==='about'?'ProfilePage':'WebPage','@id':url+'#webpage',url,name:title,description,inLanguage:lang,isPartOf:{'@id':websiteId},mainEntity:{'@id':page==='nexo'?nexoId:personId},author:{'@id':personId}};
const graph:any[]=[person,website,webPage];
if(page==='nexo')graph.push({'@type':'SoftwareApplication','@id':nexoId,name:'Nexo',applicationCategory:'EducationalApplication',operatingSystem:'Web browser',creator:{'@id':personId},description:config.nexo.solution,featureList:config.nexo.tech,image:[root+'projects/nexo-overview.png',root+'projects/nexo-learning.png'],subjectOf:{'@id':url+'#webpage'}});
if(page!=='home')graph.push({'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:lang==='en'?'Home':'Inicio',item:lang==='es'?root+'es/':root},{'@type':'ListItem',position:2,name:page==='nexo'?'Nexo':page==='about'?(lang==='en'?'About':'Acerca de'):'Creative lab',item:url}]});
const schema={'@context':'https://schema.org','@graph':graph};
---
<!doctype html>
<html lang={lang} style={{'--brand-background':palette.background,'--brand-deep':palette.deep,'--brand-ink':palette.ink,'--brand-accent':palette.accent,'--brand-accent-rgb':rgbChannels(palette.accent),'--brand-slate-rgb':rgbChannels(palette.slate),'--brand-link':palette.link,'--brand-link-hover':palette.linkHover,'--brand-button':palette.button,'--brand-button-hover':palette.buttonHover}}>
 <head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{title}</title><meta name="description" content={description}/>
  <meta name="author" content="Cristian Alvarado"/>
  <meta name="robots" content="index, follow, max-image-preview:large"/>
  <link rel="canonical" href={url}/>
  <link rel="alternate" hreflang="en" href={enUrl}/><link rel="alternate" hreflang="es" href={esUrl}/><link rel="alternate" hreflang="x-default" href={enUrl}/>
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml"/>
  <link rel="sitemap" href={`${base}sitemap.xml`} type="application/xml"/>
  <link rel="alternate" href={`${base}cris-profile.md`} type="text/markdown" title="Cristian Alvarado - factual profile"/>
  <meta name="theme-color" content={palette.background}/>
  <meta property="og:type" content={page==='home'||page==='about'?'profile':'website'}/>
  <meta property="og:site_name" content="Cris Alvarado - Engineering Portfolio"/>
  <meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={url}/>
  <meta property="og:locale" content={lang==='es'?'es_CO':'en_US'}/><meta property="og:locale:alternate" content={lang==='es'?'en_US':'es_CO'}/>
  <meta property="og:image" content={image}/><meta property="og:image:width" content={imageWidth}/><meta property="og:image:height" content={imageHeight}/><meta property="og:image:alt" content={page==='nexo'?config.nexo.overviewAlt:'Cristian Alvarado - Software Engineer, AI Systems and MCP'}/>
  <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={image}/><meta name="twitter:image:alt" content={page==='nexo'?config.nexo.overviewAlt:'Cristian Alvarado - Software Engineer'}/>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700&family=Michroma&display=swap" rel="stylesheet"/>
 </head>
 <body class="bg-dark-900 text-white font-sans antialiased overflow-x-hidden selection:bg-neon selection:text-dark-900 relative min-h-screen">
  <a class="skip-link" href="#main">{lang==='en'?'Skip to content':'Ir al contenido'}</a><slot/>
 </body>
</html>
<style is:global>
	:root {
		--accent: var(--brand-accent-rgb);
		--cyan: var(--brand-slate-rgb);
		--coral: 169, 174, 180;
		--lilac: 174, 182, 190;
	}
	html {
		scroll-behavior: smooth;
		background: var(--brand-background);
	}
	body {
		min-height: 100vh;
		background:
			url('/grain.svg'),
			radial-gradient(circle at top left, rgba(var(--brand-accent-rgb),0.012), transparent 28%),
			radial-gradient(circle at 72% 88%, rgba(var(--brand-slate-rgb),0.018), transparent 24%),
			linear-gradient(180deg, var(--brand-background) 0%, var(--brand-deep) 100%);
		background-size: 256px 256px, auto, auto, auto;
		background-blend-mode: screen, normal, normal, normal;
	}
	body::before {
		content: "";
		position: fixed;
		inset: 0;
		pointer-events: none;
		background:
			linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
		background-size: 54px 54px;
		mask-image: radial-gradient(circle at center, black, transparent 82%);
		opacity: .14;
	}
	body::after {
		content: "";
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 99;
		background: linear-gradient(180deg, transparent, rgba(var(--brand-slate-rgb),0.025), transparent);
		height: 28vh;
		animation: page-scan 9s linear infinite;
		opacity: .35;
	}
	@keyframes page-scan {
		from {
			transform: translateY(-35vh);
		}
		to {
			transform: translateY(120vh);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		body::after {
			animation: none;
			display: none;
		}
	}
	@keyframes skills-rail {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}
	.glass-surface {
		background: linear-gradient(145deg, rgba(255,255,255,0.09), rgba(255,255,255,0.035));
		border: 1px solid rgba(255,255,255,0.14);
		box-shadow:
			inset 0 1px 0 rgba(255,255,255,0.08),
			0 18px 60px rgba(0,0,0,0.24);
		backdrop-filter: blur(18px) saturate(140%);
		-webkit-backdrop-filter: blur(18px) saturate(140%);
	}
	.glass-soft {
		background: linear-gradient(145deg, rgba(255,255,255,0.06), rgba(255,255,255,0.025));
		border: 1px solid rgba(255,255,255,0.1);
		box-shadow: inset 0 1px 0 rgba(255,255,255,0.06);
		backdrop-filter: blur(14px) saturate(135%);
		-webkit-backdrop-filter: blur(14px) saturate(135%);
	}
	.glass-chip {
		background: rgba(255,255,255,0.055);
		border: 1px solid rgba(255,255,255,0.12);
		box-shadow: inset 0 1px 0 rgba(255,255,255,0.08);
		backdrop-filter: blur(12px) saturate(135%);
		-webkit-backdrop-filter: blur(12px) saturate(135%);
	}
	
	/* Custom scrollbar */
	::-webkit-scrollbar {
		width: 8px;
	}
	::-webkit-scrollbar-track {
		background: #111111;
	}
	::-webkit-scrollbar-thumb {
		background: #2a2a2a;
		border-radius: 4px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: #D3D7DA;
	}
</style>

<style is:global>
 .section-shell { padding: 5rem 1.25rem; }
 .section-heading { font-size: clamp(1.65rem, 3vw, 2.75rem); line-height: 1.25; font-weight: 600; letter-spacing: -.025em; }
 .eyebrow { color: #D3D7DA; font-size: .72rem; letter-spacing: .18em; text-transform: uppercase; font-family: 'JetBrains Mono', monospace; line-height: 1.7; }
 .primary-link { display: inline-flex; align-items: center; justify-content: center; gap: .6rem; padding: .85rem 1.2rem; border-radius: 999px; font-size: .875rem; font-weight: 600; transition: background .2s, border-color .2s; }
 .primary-link { background: var(--brand-button); color: #fff; border: 1px solid var(--brand-button); }
 .primary-link:hover { background: var(--brand-button-hover); border-color: var(--brand-button-hover); }
 .secondary-link, .text-link { display: inline-flex; align-items: center; gap: .6rem; width: fit-content; padding: .35rem 0; border-bottom: 1px solid #2997ff55; color: var(--brand-link); font-size: .875rem; line-height: 1.6; transition: color .2s, border-color .2s; }
 .secondary-link:hover, .text-link:hover { border-color: var(--brand-link-hover); color: var(--brand-link-hover); }
 .meta-line { display: flex; flex-wrap: wrap; column-gap: .85rem; row-gap: .45rem; }
 .meta-line > span:not(:last-child)::after { content: '/'; margin-left: .85rem; color: #ffffff30; }
 .folder-panel { --folder-cut: polygon(0 14px,14px 0,35% 0,calc(35% + 24px) 24px,calc(100% - 25px) 24px,100% 49px,100% calc(100% - 18px),calc(100% - 18px) 100%,18px 100%,0 calc(100% - 18px)); position: relative; isolation: isolate; padding: 4.25rem 1.5rem 1.75rem; filter: drop-shadow(0 18px 28px #00000035); }
 .folder-panel::before, .folder-panel::after { content: ''; position: absolute; pointer-events: none; clip-path: var(--folder-cut); }
 .folder-panel::before { inset: 0; z-index: -2; background: linear-gradient(135deg, #D3D7DA65, #ffffff25 42%, #D3D7DA18); }
 .folder-panel::after { inset: 1px; z-index: -1; background: radial-gradient(ellipse at 0 0, #D3D7DA0d, transparent 60%), linear-gradient(135deg, #292B2Ccc, #1C1E1Ff5 70%); backdrop-filter: blur(18px); }
 .folder-panel:hover::before { background: linear-gradient(135deg, #D3D7DAaa, #ffffff30 42%, #D3D7DA40); }
 .folder-tab { position: absolute; top: .45rem; left: 1.25rem; max-width: 30%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font: 9px 'JetBrains Mono', monospace; color: #D5D7D8; letter-spacing: .12em; text-transform: uppercase; }
 .folder-neon::before { background: linear-gradient(130deg, #F2F1EF, #AEB2B4); }
 .folder-neon::after { background: radial-gradient(ellipse at 0 0, #FFFFFF, transparent 65%), linear-gradient(135deg,#E6E7E7,#CACDCE); }
 .folder-neon .folder-tab { color: #3A3A3A; }
 .folder-neon:hover::before { background: #F2F1EF; }
 .career-track { position: absolute; left: 19px; top: 25px; bottom: 55px; width: 1px; background: #ffffff12; }
 .career-track-fill { position: absolute; inset: 0; transform-origin: top; background: linear-gradient(#D3D7DA, #D3D7DA88 75%, transparent); box-shadow: 0 0 18px #D3D7DA20; }
 .experience-node { position: relative; padding-left: 4rem; padding-bottom: 3.5rem; }
 .experience-node:last-child { padding-bottom: 0; }
 .career-node-orbit { position: absolute; left: 0; top: .25rem; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: #222426; border: 1px solid #ffffff25; box-shadow: inset 0 1px 8px #ffffff08,0 0 0 8px #050505; transition: border-color .7s,box-shadow .7s; }
 .career-node-orbit::after { content: ''; position: absolute; inset: -10px; border: 1px solid #D3D7DA18; border-radius: 50%; opacity: 0; transition: opacity .8s; }
 .experience-node[data-revealed='true'] .career-node-orbit { border-color: #D3D7DA70; box-shadow: inset 0 0 16px #D3D7DA0c,0 0 0 8px #050505,0 0 40px #D3D7DA16; animation: career-float 6s ease-in-out infinite; }
 .experience-node[data-revealed='true'] .career-node-orbit::after { opacity: 1; }
 .career-connector { position: absolute; left: 40px; top: 24px; width: 17px; height: 1px; background: linear-gradient(90deg,#D3D7DA45,transparent); }
 .career-copy { padding: .15rem 0 2.5rem; border-bottom: 1px solid #ffffff10; }
 .experience-node:last-child .career-copy { border: 0; padding-bottom: 0; }
 @keyframes career-float { 0%,100% {transform:translateY(0)} 50% {transform:translateY(-4px)} }
 @media(min-width:640px) { .folder-panel { padding: 4.5rem 2.25rem 2.25rem; } .folder-tab { left: 1.75rem; } .experience-node { padding-left: 6.5rem; padding-bottom: 4.5rem; } .career-node-orbit { width: 52px; height: 52px; } .career-track {left:25px;top:30px} .career-connector {left:52px;top:30px;width:36px} }
  @media(max-width:639px) { .nexo-diagram-labels { font-size:18px; } }
  @media(prefers-reduced-motion:reduce) { .career-node-orbit { animation: none !important; } .nexo-flow-pulse { display: none; } .nexo-floating-layer { transform: none !important; } .scroll-scene { opacity: 1 !important; transform: none !important; filter: none !important; } }
 section[id], article[id], footer[id] { scroll-margin-top: 7rem; }
 :focus-visible { outline: 2px solid var(--brand-link); outline-offset: 5px; }
 .skip-link { position: fixed; top: 1rem; left: 1rem; z-index: 200; background: #D3D7DA; color: #111111; padding: .8rem; transform: translateY(-200%); }
 .skip-link:focus { transform: none; }
 @media(min-width: 640px) { .section-shell { padding: 6rem 2rem; } }
 @media(prefers-reduced-motion: reduce) { html {scroll-behavior:auto} *, *::before, *::after { animation-duration:.01ms !important; transition-duration:.01ms !important; } }
</style>
